<UserControl x:Class="TwoFactorAuthentication.Properties.TwoFactorSignIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">
    <Grid>
        <StackPanel Name="usrPwdForm">
            <Label>User</Label>
            <TextBox Name="user"/>
            <Label>Password</Label>
            <PasswordBox Name="password"/>
            <TextBlock/>
            <Button Click="Signin_Click" IsDefault="True">Sign in</Button>
        </StackPanel>

        <StackPanel Name="codeForm" Visibility="Collapsed">
            <TextBlock Margin="0 4">We sent you a code by email</TextBlock>
            <TextBlock>Code</TextBlock>
            <TextBox Name="code" TextChanged="Code_Changed"/>
        </StackPanel>
    </Grid>
</UserControl>
