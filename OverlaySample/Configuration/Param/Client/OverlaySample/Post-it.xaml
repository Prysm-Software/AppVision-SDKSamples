      <app:CData xml:space="preserve"><![CDATA[
// create a Post-it overlay on the specified synoptic
public static async void Create(string synoptic, Point position)
{
	var msg = new UserMessageRow { Category = "Post-it", Description = "new Post-it", ContentCategory= "content" };
	var id = await Sdk.Server.EventManager.AddUserMessage(msg);
	Sdk.Server.ClientManager.UpdateOverlay(new OverlayItem {
		Name = "Event_" + id, Symbol = "OverlaySample\\Post-it.xaml", Synoptic = synoptic, Position = position, SymbolParameters = msg.Description + ";" + msg.ContentCategory, ZIndex = 10 });
}

public override void OnLoaded() 
{
	OnIdle();
	subject.TextChanged += OnTextChanged;
	body.TextChanged += OnTextChanged;
}
public override void OnIdle()
{
	if (!subject.IsFocused) subject.Text = %1;
	if (!body.IsFocused) body.Text = %2;
}

// drag'n drop Post-it note
void PinMove(object s, MouseEventArgs e)
{
	this.SetTopLeft(e.GetPosition(this.GetAncestor<Canvas>()).Substract(clicOffset));
}
Point clicOffset;

// forward text updates to the server
async void OnTextChanged(object sender, TextChangedEventArgs e)
{
	if (!((TextBoxItem)sender).IsFocused) return;
	if (t != null) return; await (t = TaskEx.Delay(2000)); t = null; // 1 update every 2 sec

	var msg = await GetLinkedUserMessage();
	if (msg != null)
	{
		msg.Description = subject.Text;
		msg.ContentCategory= body.Text;
		Server.EventManager.UpdateUserMessage(msg);
	}
}
Task t;

// retrieve the UserMessage associated with this overlay instance
public Task<UserMessageRow> GetLinkedUserMessage()
{
	var id = ((OverlayItem)Tag).Name.Substring(6).ToInt();  // "Event_nnn"
	return Server.EventManager.GetUserMessageById(id);
}

]]></app:CData>
