  <app:ButtonItem Text="Remove overlays" Foreground="#FF000000" x:Name="ButtonItem1" Width="130" Height="30" Canvas.ZIndex="20" Canvas.Left="70" Canvas.Top="130">
    <app:SynoItem.AnimationItems>
      <app:ActionAnim x:Key="MouseLeftButtonUp">
        <app:CData xml:space="preserve"><![CDATA[// Delete all overlays whose name matches the pattern 101_*
// From a client, RemoveOverlay deletes one overlay by its exact name:
// list the matching overlays first (GetOverlays accepts * in its filters).

foreach (var overlay in await Server.ClientManager.GetOverlays("Name=101_*"))
	Server.ClientManager.RemoveOverlay(overlay.Name);]]></app:CData>
      </app:ActionAnim>
    </app:SynoItem.AnimationItems>
  </app:ButtonItem>
  <app:ButtonItem Text="Create overlay A" Fill="#FF808080" Foreground="#FF000000" x:Name="ButtonItem2" Width="130" Height="30" Canvas.ZIndex="20" Canvas.Left="70" Canvas.Top="50">
    <app:SynoItem.AnimationItems>
      <app:ActionAnim x:Key="MouseLeftButtonUp">
        <app:CData xml:space="preserve"><![CDATA[var rand = new Random();

// Use the symbol A to create an overlay at a random position
// on the current synoptic

Server.ClientManager.UpdateOverlay(
	"101_A",
	 "OverlaySample\\Symbol A.xaml",
	 "OverlaySample\\Synoptic 1.xaml", 
	new Point(rand.Next(100, 700), rand.Next(50, 500)));
]]></app:CData>
      </app:ActionAnim>
    </app:SynoItem.AnimationItems>
  </app:ButtonItem>
  <app:ButtonItem Text="Create overlay B" Fill="#FF808080" Foreground="#FF000000" x:Name="ButtonItem3" Width="130" Height="30" Canvas.ZIndex="20" Canvas.Left="70" Canvas.Top="90">
    <app:SynoItem.AnimationItems>
      <app:ActionAnim x:Key="MouseLeftButtonUp">
        <app:CData xml:space="preserve"><![CDATA[var rand = new Random();

// create an overlay at a random position on the current synoptic
// with a custom parameter

Server.ClientManager.UpdateOverlay(
	name: "101_B",
	 symbol: "OverlaySample\\Symbol B.xaml",
	 synoptic: "OverlaySample\\Synoptic 1.xaml", 
	position: new Point(rand.Next(100, 700), rand.Next(50, 500)),
	symbolParameters: "some param"
	);]]></app:CData>
      </app:ActionAnim>
    </app:SynoItem.AnimationItems>
  </app:ButtonItem>
  <app:ButtonItem Text="Toggle grid" Fill="#FF808080" Foreground="#FF000000" x:Name="ButtonItem4" Width="130" Height="30" Canvas.ZIndex="20" Canvas.Left="70" Canvas.Top="170">
    <app:SynoItem.AnimationItems>
      <app:ActionAnim x:Key="MouseLeftButtonUp">
        <app:CData xml:space="preserve"><![CDATA[ToggleLayer("grid");]]></app:CData>
      </app:ActionAnim>
      <app:PropertyAnim x:Key="Text" Expression="IsLayerVisible(&quot;grid&quot;) == true ? &quot;Hide grid&quot; : &quot;Show grid&quot;" />
