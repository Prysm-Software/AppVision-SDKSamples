<Window x:Class="DriverSimple.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="300" Width="600" 
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <DockPanel>
        <StackPanel Name="inputs" Orientation="Horizontal" DockPanel.Dock="Top" Margin="4" CheckBox.Click="Inputs_Click">
            <TextBlock Text="Inputs: " Width="75" />
            <CheckBox Name="Input1"/>
            <CheckBox Name="Input2"/>
            <CheckBox Name="Input3"/>
            <CheckBox Name="Input4"/>
            <CheckBox Name="Input5"/>
            <CheckBox Name="Input6"/>
            <CheckBox Name="Input7"/>
            <CheckBox Name="Input8"/>
            <!--<Button Content=" I1 " Name="buttonInput1" Click="ButtonInput1_Click" />
            <Button Content=" I2 " Name="buttonInput2" Click="ButtonInput2_Click" />
            <Button Content=" I3 " Name="buttonInput3" Click="ButtonInput3_Click" />
            <Button Content=" I4 " Name="buttonInput4" Click="ButtonInput4_Click" />-->
        </StackPanel>
        <StackPanel Name="outputs" Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
            <TextBlock Text="Outputs: " Width="75" />
            <RadioButton Name="Output1" GroupName="o1" Margin="1 0 0 0" />
            <RadioButton Name="Output2" GroupName="o2" Margin="1 0 0 0" />
            <RadioButton Name="Output3" GroupName="o3" Margin="1 0 0 0" />
            <RadioButton Name="Output4" GroupName="o4" Margin="1 0 0 0" />
            <RadioButton Name="Output5" GroupName="o5" Margin="1 0 0 0" />
            <RadioButton Name="Output6" GroupName="o6" Margin="1 0 0 0" />
            <RadioButton Name="Output7" GroupName="o7" Margin="1 0 0 0" />
            <RadioButton Name="Output8" GroupName="o8" Margin="1 0 0 0" />
            <!--<Label Name="labelO1" Content=" O1= " />
            <Label Name="labelO2" Content=" O2= " />
            <Label Name="labelO3" Content=" O3= " />
            <Label Name="labelO4" Content=" O4= " />-->
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button Content=" Set Event " Margin="4" Click="SetEvent_Click" />
            <Button Content=" Trigger Alarm " Margin="4" Click="TriggerAlarm_Click" />
            <Button Content=" Set buffer variable "  Margin="4" Click="SetBuffer_Click" />
        </StackPanel>
        <ListBox Name="listBox1" Margin="4"/>
    </DockPanel>
</Window>
