<UserControl x:Class="WpfControlAdvanced.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:app="http://prysm.fr/AppVision"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="400"
             Background="WhiteSmoke"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{app:RColor Key=App.Color.Panel.Background}" />
        </Style>
    </UserControl.Resources>
    
    <StackPanel>
        <DockPanel>
            <Image Source="image.png" Height="64" Margin="6" HorizontalAlignment="Left"/>

            <!-- miscellaneous information -->
            <UniformGrid Columns="4" HorizontalAlignment="Left" Margin="6">
                <TextBlock MinWidth="150">Project name:</TextBlock>
                <TextBlock Name="projectName"/>
                <TextBlock>Server address:</TextBlock>
                <TextBlock Name="serverAdrs"/>
                <TextBlock>Server version:</TextBlock>
                <TextBlock Name="serverVersion"/>
                <TextBlock>Serial number:</TextBlock>
                <TextBlock Name="serialNumber"/>
                <TextBlock>User name:</TextBlock>
                <TextBlock Name="userName"/>
                <TextBlock>Container name:</TextBlock>
                <TextBlock Name="container"/>
            </UniformGrid>
        </DockPanel>

        <!-- log alarmes, events and variable changes -->
        <GroupBox Header="Events log" Margin="6">
            <ListBox Name="logs" Height="64" Background="{x:Null}" BorderThickness="0">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type app:VariableState}">
                        <TextBlock>
                            <Run Text="{Binding Date}" Foreground="Gray" />: <Run Text="{Binding Name}" FontStyle="Italic" /> = <Run Text="{Binding Value}"/>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type app:AlarmInfo}">
                        <TextBlock>
                            <Run Text="{Binding Alarm.DateStart}" Foreground="Gray" />: <Run Text="{Binding Event}" FontStyle="Italic" />: <Run Text="{Binding Alarm.StateDesc}"/> <Run Text="{Binding Alarm.Description}"/>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type app:EventRow}">
                        <TextBlock>
                            <Run Text="{Binding Date}" Foreground="Gray" />: <Run Text="{Binding StateDesc}" />: <Run Text="{Binding Description}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </GroupBox>

        <!-- load synoptics -->
        <TabControl Name="tabControl" Margin="6">
            <TabItem Header="Synoptic">
                <WrapPanel>
                    <Path Data="M18.1,22.1C18.5,22.1,21,23.1,21,23.1L21.1,26.5 18.1,25.3z M27.8,20.6L27.8,24.1 22.4,26.1 22.4,22.3z M3.9,20.5L5.6,24 0.1,26.5 0.1,25.5z M10.8,20.1L17.1,21.8 17.1,25C17.1,24.8,10.8,22.6,10.8,22.6z M31.9,18.8L31.9,22.5 28.6,23.8 28.6,20.1z M18.3,14.6C19,14.6,21,15.1,21,15.1L21,21.8 18.1,21z M9.6,14.1L9.6,22.6 6.9,23.6 4.8,19.6z M11,13.3C14.3,13.6,17.1,14.3,17.1,14.3L17.1,20.6 11,19.1z M27.8,11.8L27.8,19.5 22.5,21.3 22.5,14.5C22.5,14.3,27.1,12.1,27.8,11.8z M9.6,10.6L9.6,12.3C9.6,12.3,5.1,17.1,4.1,18.6L0.1,23.1 0.1,19.5C0.1,19.6,8.1,10.8,9.6,10.6z M10.9,10.5C11.1,10.6,21.1,12.3,21.1,12.3L21.1,14C20.5,13.8,10.9,12.1,10.9,12.1z M31.9,9.6L31.9,17.5 28.6,18.6 28.6,11.3z M32,4.6L32,8.3 22.3,13.3 22.3,11.8C22.3,11.8,29.1,7.6,32,4.6z M9.6,0.3L9.6,8.1C5,10.5,0,16.1,0,16.1L0,4z M10.9,0.1L21.1,4 21.1,9.8 10.9,8.1z M31.9,0L31.9,1.6C31.9,1.6,25.6,7.6,22.3,9.1L22.3,3.6z" Margin="6" Fill="#FF008F8F"/>
                    <ComboBox Name="synoptics" Margin="0 6" MinWidth="100" SelectedValuePath="Name" DisplayMemberPath="Description"/>
                    <Button Margin="0 6" Click="OpenSynoptic">Load</Button>
                </WrapPanel>
            </TabItem>

            <!-- trigger custom alarms -->
            <TabItem Header="Alarm">
                <WrapPanel>
                    <Path Data="M15,25L17,25 17,28 15,28z M15,11.6L17,11.6 17,22 15,22z M16,4.4L3.2,30 28.7,30z M16,0L32,32 0,32z" Fill="OrangeRed" Margin="6" />
                    <Button Margin="6" Click="TriggerAlarm">Trigger</Button>
                    <Button Margin="6" Click="AcknowledgeAlarm">Acknowledge</Button>
                </WrapPanel>
            </TabItem>

            <!-- display areas -->
            <TabItem Header="Area">
                <TreeView Name="areaTree" Background="{app:RColor Key=App.Color.Panel.Background}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <DockPanel Background="{Binding Converter={app:RowBackgroundColor}}" app:RowMenu.IsEnabled="True">
                                <Image Height="16" Source="{Binding Converter={app:RowIcon}}"/>
                                <TextBlock Text="{Binding Description}" Foreground="{Binding Converter={app:RowForegroundColor}}"/>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabItem>

            <!-- get or set variable values -->
            <TabItem Header="Variable">
                <UniformGrid Margin="6" Columns="3">
                    <ComboBox Name="variableList" SelectionChanged="VariableList_SelectionChanged" SelectedValuePath="Name" DisplayMemberPath="Row.FullDescription" />
                    <TextBox Name="variableValue"/>
                    <Button Click="SetVariableValue">Set value</Button>
                </UniformGrid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
