<Window x:Class="WizardSample.AddDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="http://prysm.fr/AppVision"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Title="Add device" Height="300" Width="400">

    <Grid app:Panel.RowDefinitions="auto * auto">

        <TextBlock Margin="20" TextWrapping="Wrap">Please input device details.</TextBlock>
        
        <Grid Grid.Row="1" Margin="20" app:Panel.Columns="2" app:Panel.Padding="8">
            <Label>Name</Label>
            <TextBox Text="{Binding Name}" Name="name"/>
            <Label>Address</Label>
            <TextBox Text="{Binding Address}"/>
            <!--<todo> if more data is required
            <Label>Other info</Label>
            <TextBox Text="{Binding OtherInfo}"/>
            -->
        </Grid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" >
            <Button Width="75" Margin="10" Content="Add" IsDefault="True" IsEnabled="{Binding Text, ElementName=name, Converter={app:EmptyToFalse}}" Click="Add_Click" />
            <Button Width="75" Margin="10" Content="Close" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
