<UserControl x:Class="WizardSample.ImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="http://prysm.fr/AppVision"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">

    <Grid app:Panel.RowDefinitions="80 * auto auto">

        <Grid Background="White">
            <Path Margin="20" HorizontalAlignment="Left" Fill="Black" Stretch="Uniform" Data="M1.68,14.04L9.89,17.37 6.37,19.28C8.24,22.78 11.89,25.19 16.14,25.19 20.63,25.19 24.48,22.52 26.23,18.68L29.46,18.68C27.55,24.21 22.31,28.20 16.14,28.20 10.76,28.20 6.08,25.17 3.71,20.73L0,22.74z M16.14,0C21.46,1.39E-07,26.08,2.96,28.48,7.32L32,5.30 30.53,14.04 22.23,10.91 25.86,8.83C23.98,5.37 20.35,3.01 16.14,3.01 11.65,3.01 7.79,5.68 6.05,9.51L2.81,9.51C4.72,3.98,9.97,1.39E-07,16.14,0z"
                  RenderTransformOrigin=".5 .5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="rotate" />
                </Path.RenderTransform>
                <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="rotate" Storyboard.TargetProperty="Angle"
                                                 To="180" BeginTime="0:0:1" Duration="0:0:2">
                                    <DoubleAnimation.EasingFunction>
                                        <ExponentialEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>
            </Path>
            <Image Margin="8" HorizontalAlignment="Right" Source="/Resources/app-company2.png" />
            <TextBlock Margin="100 10" VerticalAlignment="Center">
                <Span FontSize="16" FontWeight="Bold">Import</Span>
                <LineBreak/>
                <Span FontSize="14">Import in progress...</Span>
            </TextBlock>
        </Grid>

        <ListBox Grid.Row="1" Margin="10 10 10 0" ItemsSource="{Binding Details}" />

        <ProgressBar Grid.Row="2" Margin="10 0" Height="12" IsIndeterminate="{Binding IsBusy}" Value="{Binding Progress}" Minimum="0" Maximum="1" />

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Width="75" Margin="10" Content="Cancel" IsDefault="True" Command="{Binding CancelImportCommand}"/>
        </WrapPanel>
    </Grid>
</UserControl>
