<UserControl x:Class="WizardSample.LoginAppPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="http://prysm.fr/AppVision"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             Loaded="OnLoaded">

    <Grid app:Panel.RowDefinitions="80 auto * auto">

        <Grid Background="White">
            <Path Margin="20" HorizontalAlignment="Left" Fill="Black" Stretch="Uniform" Data="M29.2,18.3C28.4,18.3 27.8,18.9 27.8,19.7 27.8,20.5 28.4,21.1 29.2,21.1 30,21.1 30.6,20.5 30.6,19.7 30.6,18.9 30,18.3 29.2,18.3z M28.1,16.9C30.3,16.9 32,18.6 32,20.8 32,23.0 30.2,24.7 28.1,24.7 27.6,24.7 27.1,24.6 26.7,24.5L24.6,26.6 23.2,26.6 23.2,28.0 21.8,28.0 21.8,29.4 19.5,29.4 19.5,27.0 24.3,22.2C24.2,21.7 24.1,21.3 24.1,20.8 24.2,18.6 25.9,16.9 28.1,16.9z M13.2,0L13.3,0C18.4,-7.3E-08 19.3,3.6 19.2,5.0 19.1,6.1 18.8,7.6 18.8,7.6 18.8,7.6 19.3,7.8 19.3,8.8 19.1,11.3 18.1,10.2 17.9,11.3 17.5,13.4 16.7,13.5 16.4,14.3 16.3,14.5 16.3,14.7 16.3,14.9 16.3,17.3 17.5,18.4 21.1,19.7 21.9,20.0 22.6,20.3 23.2,20.5L23.2,20.7C23.2,21.1,23.2,21.4,23.3,21.8L18.6,26.5 18.6,29.2 0,29.2 0,23.2C0,22.3 1.6,20.9 5.3,19.6 9,18.3 10.1,17.2 10.1,14.8 10.1,14.5 10.1,14.3 10,14.2 9.7,13.5 8.9,13.4 8.5,11.2 8.3,10.1 7.3,11.2 7.1,8.7 7.1,7.7 7.6,7.5 7.6,7.5 7.6,7.5 7.4,6.1 7.3,5.0 7.2,3.6 8.1,-7.3E-08 13.2,0z" />
            <Image Margin="8" HorizontalAlignment="Right" Source="/Resources/app-company2.png" />
            <TextBlock Margin="100 10" VerticalAlignment="Center">
                <Span FontSize="16" FontWeight="Bold">Connection to <Run Text="{app:RT App.Name}"/> server</Span>
                <LineBreak />
                <Span FontSize="14">Input your <Run Text="{app:RT App.Name}"/> credentials</Span>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Margin="20" VerticalAlignment="Top"></TextBlock>

        <Grid Grid.Row="2" Margin="20" app:Panel.Columns="2" app:Panel.Padding="8">
            <TextBlock><Run Text="{app:RT App.Name}"/> server (host or IP)</TextBlock>
            <t:RadComboBox Text="{Binding AppHostname, Mode=TwoWay}" IsEditable="True" ItemsSource="{Binding AppServers.Servers}">
                <t:RadComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding}"/>
                            <TextBlock Text="{Binding Address}" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </t:RadComboBox.ItemTemplate>
            </t:RadComboBox>
            <Label>User</Label>
            <TextBox Text="{Binding AppUsername}" />
            <Label>Password</Label>
            <t:RadPasswordBox Name="pwd" TextChanged="pwd_TextChanged" />
        </Grid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Width="75" Margin="10" Content="Next" IsDefault="True" Command="{Binding DiscoveryCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
