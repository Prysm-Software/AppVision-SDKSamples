<UserControl x:Class="WizardSample.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="http://prysm.fr/AppVision"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">

    <Grid app:Panel.RowDefinitions="80 auto * auto">

        <Grid Background="White">
            <Path Margin="20" HorizontalAlignment="Left" Fill="Black" Stretch="Uniform" Data="M25.8,25.2L25.2,25.8 25.2,26.7 25.8,27.3 26.7,27.3 27.3,26.7 27.3,25.8 26.7,25.2z M20.8,15.6L28.4,23.2C29.8,24.6 29.8,26.9 28.4,28.4 26.9,29.8 24.6,29.8 23.2,28.4L14.8,20.0 16.8,17.9 18.7,19.8 21.0,17.5 20.8,17.2C20.6,16.7,20.6,16.1,20.8,15.6z M27.2,1.1L32.0,5.8 23.3,14.5C22.5,14.0 21.4,14.2 20.8,14.9 20.1,15.6 19.9,16.6 20.4,17.4L18.7,19.1 16.8,17.2 9.0,25.1 9.1,25.1 8.9,25.9 5.6,28.3 4.7,27.5 7.1,24.1 7.9,23.9 7.9,24.0 15.8,16.2 13.9,14.3 15.6,12.6C16.4,13.1 17.4,12.9 18.1,12.2 18.8,11.6 19.0,10.5 18.5,9.7z M6.9,4.0E-05C8.6,0.0 10.4,0.6 11.7,2.0 13.5,3.7 14.1,6.1 13.6,8.4L17.4,12.2C17.1,12.3 16.9,12.4 16.6,12.4 16.3,12.4 16.1,12.3 15.8,12.2L15.5,12.0 13.2,14.3 15.1,16.2 13.0,18.2 8.4,13.6C6.1,14.1 3.7,13.5 2.0,11.7 0.2,10.0 -0.3,7.4 0.2,5.1L5.0,10.0 8.4,8.4 10.0,5.0 5.1,0.2C5.7,0.0,6.3,-0.0,6.9,4.0E-05z" />
            <Image Margin="8" HorizontalAlignment="Right" Source="/Resources/app-company2.png" Width="64" />
            <TextBlock Margin="100 10" VerticalAlignment="Center">
                <Span FontSize="16" FontWeight="Bold"><Run Text="{app:RT App.Name}"/> settings</Span>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Margin="20 20 20 0" TextWrapping="Wrap">
            Please, review <Run Text="{app:RT App.Name}"/> configuration settings.</TextBlock>

        <Grid Name="less" Margin="12" Grid.Row="2" app:Panel.Columns="2" app:Panel.Padding="8">
            <Label>Device name</Label>
            <TextBox Text="{Binding NodeName}" />
            <Label>Device description</Label>
            <TextBox Text="{Binding NodeDescription}" />
            <Button Grid.Column="1" HorizontalAlignment="Right" Content=" More " Click="More_Click"/>
        </Grid>
        <Grid Name="more" Margin="12" Grid.Row="2" app:Panel.Columns="2" app:Panel.Padding="8" Visibility="Collapsed">
            <Label>Protocol name</Label>
            <TextBox Text="{Binding ProtocolName}" />
            <Label>Device name</Label>
            <TextBox Text="{Binding NodeName}" />
            <Label>Device description</Label>
            <TextBox Text="{Binding NodeDescription}" />
            <Label></Label>
            <!-- <todo> add or remove settings if necessary
            <Label>Other settings</Label>
            <TextBox Text="{Binding OtherSettings}" />
            example: -->
            <CheckBox IsChecked="{Binding CreateGroup}">Create group for this device</CheckBox>
            <Label>Entity symbol</Label>
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding BrowseSymbolCommand}">...</Button>
                <TextBox Text="{Binding EntitySymbol}"/>
            </DockPanel>
        </Grid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Width="75" Margin="10" Content="Previous" IsCancel="True" Command="{Binding DeviceDetailCommand}" />
            <Button Width="75" Margin="10" Content="Next" IsDefault="True" Command="{Binding SummaryCommand}" />
        </WrapPanel>

    </Grid>
</UserControl>
