            <Image Margin="8" HorizontalAlignment="Right" Source="/Resources/app-company2.png" />
            <TextBlock Margin="100 10" VerticalAlignment="Center">
                <Span FontSize="16" FontWeight="Bold">Discover WizardSample</Span>
                <LineBreak />
                <Span FontSize="14">Select devices to import</Span>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0 10 10 0" HorizontalAlignment="Right">
            <Run Text="{Binding SelectedDevices.Count, Mode=OneWay}"/>/
            <Run Text="{Binding Devices.Count, Mode=OneWay}"/> device(s) selected.
        </TextBlock>

        <!--        
        <todo> use SelectedDevices collection if batch import is suppported
        use SelectedDevice object if device must be imported one by one.
        -->
        <t:RadGridView x:Name="grid" Grid.Row="2" Margin="10 0"
                       ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionMode="Extended" SelectionChanged="SelectionChanged"
                       AutoGenerateColumns="False" IsReadOnly="True" ShowGroupPanel="False" RowIndicatorVisibility="Collapsed" GridLinesVisibility="None" >
            <t:RadGridView.Columns>
                <t:GridViewSelectColumn />
                <t:GridViewImageColumn Header="" DataMemberBinding="{Binding Icon}" ErrorImageSource="/Resources/device.png" ImageHeight="16" />
                <t:GridViewDataColumn Header="Device" DataMemberBinding="{Binding Name}" />
                <t:GridViewDataColumn Header="Address" DataMemberBinding="{Binding Address}" />

                <!-- <todo> add more info if necessary
                <t:GridViewDataColumn Header="Other info" DataMemberBinding="{Binding OtherInfo}" />-->

                <!-- display a check mark if device is already in the configuration-->
                <t:GridViewColumn Header="" Width="6" SortMemberPath="VariableRow.Name" FilterMemberPath="VariableRow.Name">
                    <t:GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="checkMark" Text="✓" Visibility="{Binding VariableRow, Converter={app:NullToCollapsed}}">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding VariableRow.Name}" ContentStringFormat="This device is already imported as $V.{0}"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </t:GridViewColumn.CellTemplate>
                </t:GridViewColumn>
            </t:RadGridView.Columns>
        </t:RadGridView>

        <t:RadPathButton Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Height="22" Width="22" Margin="40 4"
                         IsBackgroundVisible="False" ToolTip="Search" Command="t:RadGridViewCommands.Search" CommandTarget="{x:Reference grid}"
                         PathGeometry="F1M-185,-2026L-203,-2048C-197,-2056 -197,-2067 -203,-2075 -211,-2084 -225,-2086 -234,-2078 -244,-2071 -245,-2057 -238,-2047 -231,-2039 -221,-2037 -212,-2041L-195,-2019 -185,-2026z M-231,-2053C-235,-2059 -234,-2067 -229,-2071 -223,-2076 -215,-2075 -210,-2069 -206,-2063 -207,-2055 -212,-2051 -218,-2046 -226,-2047 -231,-2053z" />

        <ProgressBar Grid.Row="3" Margin="10 0" Height="12" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={app:ToVisible}}" Minimum="0" Maximum="1" />

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button Width="75" Margin="10" Content="Previous" IsCancel="True" Command="{Binding AppLoginCommand}" />
            <Button Width="75" Margin="10" Content="Next" IsDefault="True" Command="{Binding DeviceLoginCommand}" />
        </WrapPanel>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Left">
            <!--<todo> add more action as needed-->
            <Button Width="75" Margin="10" Content="Rescan" Command="{Binding RescanCommand}" />
            <Button Width="75" Margin="10" Content="Add" Command="{Binding AddDeviceCommand}" />
        </WrapPanel>
