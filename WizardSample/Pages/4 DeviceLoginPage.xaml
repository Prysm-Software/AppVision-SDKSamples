<UserControl x:Class="WizardSample.DeviceLoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:t="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:app="http://prysm.fr/AppVision"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">

    <Grid app:Panel.RowDefinitions="80 auto * auto">

        <Grid Background="White">
            <Path Margin="20" HorizontalAlignment="Left" Fill="Black" Stretch="Uniform" Data="M11.55,14.26C11.89,15.06,12.33,15.82,12.83,16.52L3.08,26.27C2.65,26.70 2.65,27.39 3.08,27.82 3.50,28.25 4.20,28.25 4.62,27.82L14.27,18.17C15.47,19.30,16.91,20.18,18.51,20.73L18.51,22.46C18.51,23.01,18.06,23.46,17.51,23.46L14.77,23.46 14.77,26.20C14.77,26.75,14.32,27.20,13.77,27.20L11.03,27.20 11.03,29.95C11.03,30.50,10.58,30.94,10.03,30.94L7.23,30.94 6.53,31.64C6.11,32.07 1.84,32.29 0.77,31.22 -0.29,30.15 -0.07,25.88 0.35,25.45z M25.37,3.38C23.58,3.38 22.12,4.83 22.12,6.62 22.12,8.41 23.58,9.87 25.37,9.87 27.16,9.87 28.61,8.41 28.61,6.62 28.61,4.83 27.16,3.38 25.37,3.38z M22.25,0C27.63,1.02E-07 32,4.36 32,9.74 32,15.12 27.63,19.48 22.25,19.48 16.87,19.48 12.51,15.12 12.51,9.74 12.51,4.36 16.87,1.02E-07 22.25,0z" />
            <Image Margin="8" HorizontalAlignment="Right" Source="/Resources/prysm.png" />
            <TextBlock Margin="100 10" VerticalAlignment="Center">
                <Span FontSize="16" FontWeight="Bold">Connection to WizardSample device</Span>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Margin="20" VerticalAlignment="Top"></TextBlock>

        <Grid Grid.Row="2" Margin="20" app:Panel.Columns="2" app:Panel.Padding="8">
            <Label>WizardSample address</Label>
            <TextBox Text="{Binding DeviceHostname}" />
            <Label>User</Label>
            <TextBox Text="{Binding DeviceUsername}" />
            <Label>Password</Label>
            <t:RadPasswordBox Text="{Binding DevicePassword}" />
        </Grid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Width="75" Margin="10" Content="Previous" IsCancel="True" Command="{Binding DiscoveryCommand}" />
            <Button Width="75" Margin="10" Content="Next" IsDefault="True" Command="{Binding DeviceDetailsCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
